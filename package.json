{
  "name": "chelonia-todomvc",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "description": "TodoMVC built on Chelonia: a real contract for identity, a KV slot for the todos",
  "license": "MIT",
  "scripts": {
    "contracts": "node scripts/build-contracts.ts",
    "dev": "npm run contracts && vite build --watch",
    "build": "npm run contracts && vite build",
    "serve": "node scripts/chel.ts serve --dev --port 8000 dist",
    "start": "npm run build && npm run serve",
    "lint": "eslint .",
    "typecheck": "npm run contracts && vue-tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "test:e2e": "playwright test",
    "test:all": "npm run typecheck && npm test && npm run test:e2e"
  },
  "dependencies": {
    "@chelonia/crypto": "1.0.1",
    "@chelonia/lib": "1.5.0",
    "@sbp/sbp": "2.4.1",
    "buffer": "6.0.3",
    "vue": "3.5.13"
  },
  "devDependencies": {
    "@chelonia/cli": "3.4.0",
    "@eslint/js": "9.17.0",
    "@playwright/test": "1.49.1",
    "@types/node": "22.10.5",
    "@vitejs/plugin-vue": "5.2.1",
    "eslint": "9.17.0",
    "eslint-plugin-vue": "9.32.0",
    "typescript": "5.7.3",
    "typescript-eslint": "8.19.1",
    "vite": "6.0.7",
    "vue-tsc": "2.2.0"
  }
}
