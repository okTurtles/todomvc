# The demo's chel server, as a systemd user service. See docs/hosting.md.
#
#   cp deploy/todomvc.service ~/.config/systemd/user/
#   systemctl --user enable --now todomvc
#   loginctl enable-linger "$USER"   # keeps it running after you log out

[Unit]
Description=TodoMVC on Chelonia (public demo)
After=network-online.target

[Service]
WorkingDirectory=%h/todomvc
# Turns on chel's signup rate limits, which are off outside production
Environment=NODE_ENV=production
# Node 22.18 or newer. Use the full path that `which node` prints.
ExecStart=/usr/bin/node scripts/chel.ts serve --port 8000 dist
Restart=on-failure

[Install]
WantedBy=default.target
